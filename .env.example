PORT=3000
DATA_DIR=./data

# Default: MiniMax CN (国内直连，Anthropic 兼容协议，见 README)
PI_PROVIDER=minimax-cn
PI_MODEL=MiniMax-M2.7
# MINIMAX_CN_API_KEY=...        # for PI_PROVIDER=minimax-cn (api.minimaxi.com)

# Built-in OpenAI:
# PI_PROVIDER=openai
# PI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=sk-...

# Built-in Anthropic:
# PI_PROVIDER=anthropic
# PI_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# Chinese models / any OpenAI Chat Completions-compatible provider:
# PI_PROVIDER=custom
# PI_BASE_URL=https://api.deepseek.com
# PI_API_KEY=your-provider-api-key
# PI_MODEL=deepseek-chat
# PI_CONTEXT_WINDOW=128000
# PI_MAX_TOKENS=8192
#
# The endpoint must implement streamed chat completions + tool calling.
# For an already-running local server, an HTTP URL is also valid.
#
# Set ONE credential for the live Pi Agent. Without configured credentials
# this site runs in explicitly labeled OFFLINE SCRIPT mode; that is not
# Pi model-driven agent behavior.
