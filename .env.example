PORT=3000
DATA_DIR=./data

# Default: built-in OpenAI provider
PI_PROVIDER=openai
PI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=sk-...

# Built-in Anthropic:
# PI_PROVIDER=anthropic
# PI_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# Chinese models / any OpenAI Chat Completions-compatible provider:
# PI_PROVIDER=custom
# PI_BASE_URL=https://api.deepseek.com
# PI_API_KEY=your-provider-api-key
# PI_MODEL=deepseek-chat
# PI_CONTEXT_WINDOW=128000
# PI_MAX_TOKENS=8192
#
# The endpoint must implement streamed chat completions + tool calling.
# For an already-running local server, an HTTP URL is also valid.
#
# Without configured credentials this site runs in explicitly labeled
# OFFLINE SCRIPT mode; that is not Pi model-driven agent behavior.
